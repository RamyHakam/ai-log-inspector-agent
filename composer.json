{
  "name": "hakam/ai-log-inspector-agent",
  "description": "AI-powered log inspector agent for PHP",
  "type": "library",
  "license": "MIT",
  "keywords": ["ai", "log", "inspector", "agent", "symfony", "llm", "semantic-search"],
  "authors": [
    {
      "name": "Ramy Hakam",
      "email": "ramyhakam1@gmail.com"
    }
  ],
  "homepage": "https://github.com/RamyHakam/ai-log-inspector-agent",
  "require": {
    "php": "^8.4",
    "symfony/ai-agent": "^1.0@beta",
    "symfony/ai-platform": "^1.0@beta",
    "symfony/ai-store": "^1.0@beta",
    "symfony/ai-ollama-platform": "^1.0@beta",
    "symfony/ai-open-ai-platform": "^1.0@beta",
    "symfony/ai-anthropic-platform": "^1.0@beta",
    "psr/log": "^3.0",
    "symfony/cache": "^8.0",
    "symfony/ai-cache-store": "^1.0@beta",
    "mcp/sdk": "^0.10"
  },
  "autoload": {
    "psr-4": {
      "Hakam\\AiLogInspector\\": "src/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always",
    "cs-fix": "dev-tools/vendor/bin/php-cs-fixer fix"
  },
  "autoload-dev": {
    "psr-4": {
      "Hakam\\AiLogInspector\\Test\\": "test/"
    }
  },
  "require-dev": {
    "symfony/test-pack": "^1.2",
    "dg/bypass-finals": "^1.9",
    "symfony/dotenv": "^8.0"
  },
  "minimum-stability": "beta",
  "prefer-stable": true
}
