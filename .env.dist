# Copy to .env and fill in one provider. The MCP server and the demo read this file.
LOG_INSPECTOR_PROVIDER=openai          # openai | anthropic | ollama
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=                   # anthropic needs an embedding provider: openai or ollama
# LOG_INSPECTOR_EMBEDDING_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# LOG_INSPECTOR_MODEL=gpt-5.4-mini
# LOG_INSPECTOR_PATHS=/var/log/myapp,/path/to/symfony/var/log/prod.log
